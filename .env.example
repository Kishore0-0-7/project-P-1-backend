# Backend-only production configuration. Never expose this file through the frontend.
# Copy to backend/.env and replace every placeholder before deployment.
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME?sslmode=require"
APP_ENV=production
DEBUG=false
DB_SCHEMA=opstriage
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
# Use the TLS endpoint supplied by your managed Redis/Valkey provider.
REDIS_URL=rediss://default:<password>@<host>:<port>
REDIS_FINDINGS_TTL=10
REDIS_REPORTS_TTL=300
JWT_SECRET=replace-with-a-random-secret-of-at-least-64-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=["https://app.example.com"]
RATE_LIMIT_PER_MINUTE=300
WORKER_CONCURRENCY=4
INGEST_BATCH_SIZE=500
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
AI_ENABLED=true
AI_TIMEOUT_SECONDS=60
SUPPORT_CHAT_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=1500
